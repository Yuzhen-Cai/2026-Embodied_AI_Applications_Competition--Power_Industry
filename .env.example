# ====================================================================
# 阿里云 OSS 凭据模板
#
# 使用方法：复制本文件为项目根目录下的 .env，并填入真实值。
# 注意：.env 已被 .gitignore 忽略，不会被提交到 git；请勿把真实密钥写进本模板。
# ====================================================================

# 阿里云 AccessKey（建议使用 RAM 子账号，仅授予 OSS 相关权限，勿用主账号）
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret

# OSS Bucket 名称（全局唯一，需先在阿里云控制台创建）
OSS_BUCKET=your-bucket-name

# OSS 地域端点（S3 兼容地址），按你的 bucket 所在地域填写
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 地域（一般与 endpoint 所在地域一致即可）
OSS_REGION=cn-hangzhou
